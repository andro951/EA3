# Copy to .env. Keep API credentials here, never in browser settings or source control.
HOST=127.0.0.1
PORT=4173
# A full OpenAI-compatible chat-completions URL, or a local compatible server.
# TEXT_ENDPOINT=http://127.0.0.1:8080/v1/chat/completions
TEXT_API_KIND=chat
TEXT_MODEL=local-model
# TEXT_API_KEY=
TEXT_CONTEXT_CHARS=64000
TEXT_MAX_TOKENS=1600
# Image endpoint must return base64 raster data, not a remote image URL.
# IMAGE_ENDPOINT=http://127.0.0.1:8080/v1/images/generations
IMAGE_API_KIND=images
IMAGE_MODEL=local-image-model
IMAGE_SIZE=1024x1024
# IMAGE_API_KEY=
PROVIDER_TIMEOUT_MS=180000
# PUBLIC_MODE=1 disables unauthenticated generation; configure deployment auth separately.
